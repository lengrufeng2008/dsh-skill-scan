{
  "name": "dsh-skill-scan",
  "version": "0.1.0",
  "description": "Static, read-only security first pass for DSH skills and plugin bundles: instruction override, remote shell, credentials, lifecycle scripts, JS patches, and obfuscation.",
  "type": "module",
  "bin": { "dsh-skill-scan": "bin/dsh-skill-scan.mjs" },
  "exports": {
    ".": "./plugin/index.js",
    "./scan": "./src/scan.mjs",
    "./plugin": "./plugin/index.js",
    "./icon": "./icon.svg"
  },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "security", "skill", "scanner", "supply-chain"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-skill-scan" }
}
